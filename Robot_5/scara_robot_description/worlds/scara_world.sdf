<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="scara_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="mesa_depositos">
      <static>true</static>
      <pose>0.01 0.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.22 0.10 0.008</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.22 0.10 0.008</size></box></geometry>
          <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.45 0.28 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="plat_pick">
      <static>true</static>
      <pose>-0.141 0.129 0.2 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.0 0.7 1.0 1</ambient><diffuse>0.0 0.7 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_pick">
      <static>true</static>
      <pose>-0.141 0.129 0.2 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.020</radius></sphere></geometry>
          <material><ambient>0.0 0.85 1.0 1</ambient><diffuse>0.0 0.85 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="deposito_C1">
      <static>true</static>
      <pose>0.076 0.204 0.2 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.020</radius></sphere></geometry>
          <material><ambient>1.0 0.9 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="deposito_C2">
      <static>true</static>
      <pose>0.016 0.229 0.2 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.020</radius></sphere></geometry>
          <material><ambient>1.0 0.45 0.0 1</ambient><diffuse>1.0 0.45 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="deposito_C3">
      <static>true</static>
      <pose>-0.054 0.209 0.2 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.020</radius></sphere></geometry>
          <material><ambient>1.0 0.1 0.1 1</ambient><diffuse>1.0 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>